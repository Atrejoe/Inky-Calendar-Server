# Template for Kubernetes secrets
# Copy this file to secrets.env and fill in your values
# The secrets.env file is gitignored and will not be committed

db-password=YOUR_DB_PASSWORD
bugsnag-api-key=YOUR_BUGSNAG_API_KEY
sentry-dsn=YOUR_SENTRY_DSN
google-oauth-client-secret=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
openweather-api-key=YOUR_OPENWEATHER_API_KEY
openai-api-key=YOUR_OPENAI_API_KEY

# Redis connection string for cache (when Cache__Type=Redis)
# Format: redis-service-name:port or redis-service-name.namespace:port
# For InkyCal deployment, use: redis.[namespace]:6379
redis-connection-string=redis.[namespace]:6379
