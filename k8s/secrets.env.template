# Template for Kubernetes secrets
# Copy this file to secrets.env and fill in your values
# The secrets.env file is gitignored and will not be committed

db-password=YOUR_DB_PASSWORD
bugsnag-api-key=YOUR_BUGSNAG_API_KEY
sentry-dsn=YOUR_SENTRY_DSN
google-oauth-client-secret=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
openweather-api-key=YOUR_OPENWEATHER_API_KEY
openai-api-key=YOUR_OPENAI_API_KEY

# Six Labors (ImageSharp v4+) license key.
# NOTE: this is a *build-time* secret - it is compiled into the image and is not
# read by the running pod, so it is intentionally not referenced in
# web-deployment.yaml. It is stored here so the same value can be reused when
# building the image (docker build --secret id=sixlabors_license,env=SIXLABORS_LICENSE_KEY .)
# and mirrored into the SIXLABORS_LICENSE_KEY GitHub Actions secret for CI builds.
sixlabors-license-key=YOUR_SIXLABORS_LICENSE_KEY
