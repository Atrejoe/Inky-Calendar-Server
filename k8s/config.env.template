# Template for Kubernetes ConfigMap values
# Copy this file to config.env and fill in your values
# The config.env file can be committed to git (non-sensitive values only)

# Time zone setting
TZ=Europe/Amsterdam

# Optional settings Google calender integration
# See also secrets.env for sensitive values
GoogleOAuth__Enabled=true
GoogleOAuth__ClientId=YOUR_GOOGLE_OAUTH_CLIENT_ID
GoogleOAuth__ProjectId=YOUR_GOOGLE_OAUTH_PROJECT_ID
GoogleOAuth__Website=YOUR_WEBSITE_URL
GoogleOAuth__InkyCalRoot=/

TraceQueries=false

# Database connection settings, see also secrets.env for sensitive values
DB_Server=YOUR_DB_SERVER
DB_Database=YOUR_DB_DATABASE
DB_User=YOUR_DB_USER

# Cache configuration
# Type can be: Memory or Redis (enum values, case-insensitive)
Cache__Type=Redis
# Memory cache size limit in bytes (default: 524288000 = 500MB)
Cache__Memory__SizeLimit=524288000

# Redis connection string for read/write splitting:
# - redis-master: Routes only to master (redis-0) for write operations
# - redis-headless: Routes to all pods for read distribution
# The client will automatically route:
#   - Writes (SET, locks) -> master
#   - Reads (GET) -> any available pod (master or replicas)
Cache__Redis__ConnectionString=redis-master.inkycal.svc.cluster.local:6379,redis-headless.inkycal.svc.cluster.local:6379,abortConnect=false
