@inherits ComponentBase
@using InkyCal.Models.Helpers

<div class="form-group">
	<label for="newspaperSelector" class="sr-only">Select Newspaper</label>
	<InputSelect id="newspaperSelector" class="form-control custom-select" @bind-Value="@NewsPaperId" aria-label="Select a newspaper by country">
		@if (!(NewsPapers?.Any()).GetValueOrDefault(false))
		{
			<option value="" disabled selected>No newspapers available</option>
		}
		else
		{
			<option value="">Select a newspaper</option>

			@foreach (var country in NewsPapers.OrderBy(x => x.Key))
			{
				<optgroup label="@country.Key">
					@foreach (var newspaper in country.OrderBy(x => x.Title))
					{
						<option value="@newspaper.PaperId" title="@newspaper.Title">@newspaper.Title (@newspaper.City)</option>
					}
				</optgroup>
			}
		}
	</InputSelect>
</div>